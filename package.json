{
  "name": "@antelopejs/tooling-configs",
  "version": "0.2.16",
  "description": "Shared tooling presets for AntelopeJS repositories: oxlint (with the vendored anti-slop rules), oxfmt, ESLint for Nuxt layers, Knip, and an interface range check",
  "keywords": [
    "antelopejs",
    "anti-slop",
    "eslint",
    "knip",
    "oxc",
    "oxfmt",
    "oxlint"
  ],
  "homepage": "https://github.com/AntelopeJS/tooling-configs#readme",
  "bugs": {
    "url": "https://github.com/AntelopeJS/tooling-configs/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/tooling-configs.git"
  },
  "bin": {
    "antelopejs-api-diff": "./dist/bin/api-diff.mjs",
    "antelopejs-body-check": "./dist/bin/body-check.mjs",
    "antelopejs-check-interface-ranges": "./dist/bin/check-interface-ranges.mjs",
    "antelopejs-check-size": "./dist/bin/check-size.mjs",
    "antelopejs-checks": "./dist/bin/checks.mjs",
    "antelopejs-comment-proof": "./dist/bin/comment-proof.mjs",
    "antelopejs-garden": "./dist/bin/garden.mjs",
    "antelopejs-ratchet": "./dist/bin/ratchet.mjs",
    "antelopejs-suppressions": "./dist/bin/suppressions.mjs",
    "antelopejs-sync": "./dist/bin/sync.mjs",
    "antelopejs-verify": "./dist/bin/verify.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./oxc/lint": "./dist/oxc/lint.mjs",
    "./oxc/fmt": "./dist/oxc/fmt.mjs",
    "./oxc/anti-slop": "./dist/oxc/anti-slop/index.mjs",
    "./oxc/guardrails": "./dist/oxc/guardrails/index.mjs",
    "./knip": "./dist/knip.mjs",
    "./eslint": "./dist/eslint.mjs",
    "./verify": "./dist/verify/index.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run prepack && release-it",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "checks": "node src/bin/checks.ts",
    "format:check": "oxfmt --check .",
    "size": "node src/bin/check-size.ts",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "sync": "node src/bin/sync.ts",
    "sync:check": "node src/bin/sync.ts --check",
    "knip": "knip",
    "suppressions": "node src/bin/suppressions.ts",
    "suppressions:update": "node src/bin/suppressions.ts --update"
  },
  "dependencies": {
    "@oxlint/plugins": "1.81.0",
    "dts-bundle-generator": "^9.5.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@types/node": "^24.13.3",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "@nuxt/eslint-config": ">=1.2.0",
    "eslint-plugin-perfectionist": ">=5.0.0",
    "knip": ">=6.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0"
  },
  "peerDependenciesMeta": {
    "knip": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "@nuxt/eslint-config": {
      "optional": true
    },
    "eslint-plugin-perfectionist": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.2.0"
}
